{
  "name": "properly-vacation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run @app/template-admin#dev",
    "dev:admin": "vp run @app/template-admin#dev",
    "dev:api": "vp run @app/template-api#dev",
    "dev:all": "run-p dev:admin dev:api",
    "test:integration": "vp run @app/template-api#test:integration",
    "api:generate": "vp run @app/template-api#generate",
    "api:migrate": "vp run @app/template-api#migrate",
    "api:push": "vp run @app/template-api#push",
    "api:seed": "vp run @app/template-api#seed",
    "lint": "run-s lint:*",
    "lint:oxlint": "vp lint . --fix",
    "lint:eslint": "vp lint . --fix",
    "prepare": "vp config"
  },
  "devDependencies": {
    "npm-run-all2": "catalog:",
    "unplugin-vue": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "pnpm@11.5.1"
}
