{
  "name": "@app/template-api",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "start": "dotenvx run -- node dist/index.js",
    "check": "vp check",
    "type-check": "vp exec tsgo --noEmit",
    "test": "vp test --passWithNoTests",
    "test:integration": "RUN_INTEGRATION=true vp test",
    "generate": "vp exec drizzle-kit generate --config drizzle.config.ts",
    "pull": "vp exec drizzle-kit pull --config drizzle.config.ts",
    "up": "vp exec drizzle-kit up --config drizzle.config.ts",
    "push": "vp exec drizzle-kit push --config drizzle.config.ts",
    "studio": "vp exec drizzle-kit studio --config drizzle.config.ts",
    "seed": "vp exec tsx migrations/seed/index.ts",
    "migrate": "vp exec drizzle-kit migrate --config drizzle.config.ts",
    "db:comments": "vp exec tsx scripts/sync-comments.ts",
    "db:comments:dry": "vp exec tsx scripts/sync-comments.ts --dry-run",
    "db:migrate": "vp run migrate && vp run db:comments",
    "db:push": "vp run push && vp run db:comments"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "catalog:",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@cap.js/server": "catalog:",
    "@casbin/redis-watcher": "catalog:",
    "@dotenvx/dotenvx": "catalog:",
    "@hono/node-server": "catalog:hono",
    "@hono/node-ws": "catalog:hono",
    "@hono/sentry": "catalog:hono",
    "@hono/zod-openapi": "catalog:hono",
    "@monorepo/server-core": "workspace:*",
    "@monorepo/server-refine-query": "workspace:*",
    "@monorepo/utils": "workspace:*",
    "@node-rs/argon2": "catalog:",
    "@scalar/hono-api-reference": "catalog:",
    "bullmq": "catalog:",
    "casbin": "catalog:",
    "date-fns": "catalog:utils",
    "drizzle-orm": "catalog:database",
    "effect": "catalog:",
    "excelize-wasm": "catalog:",
    "hono": "catalog:hono",
    "hono-pino": "catalog:hono",
    "hono-rate-limiter": "catalog:hono",
    "iconv-lite": "catalog:",
    "ioredis": "catalog:",
    "pino": "catalog:",
    "postgres": "catalog:database",
    "rate-limit-redis": "catalog:",
    "redlock-universal": "catalog:",
    "zod": "catalog:utils"
  },
  "devDependencies": {
    "@bull-board/api": "catalog:",
    "@bull-board/hono": "catalog:",
    "@bull-board/ui": "catalog:",
    "@hono/vite-dev-server": "catalog:hono",
    "@monorepo/server-vite-plugin": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "catalog:database",
    "glob": "catalog:",
    "oxc-parser": "catalog:",
    "pino-pretty": "catalog:",
    "tsx": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
